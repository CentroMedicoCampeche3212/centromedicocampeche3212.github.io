---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { contact } from '@/data/site';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que busca no existe o cambió de dirección."
>
  <Section>
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-medium tracking-[0.14em] text-primary uppercase">Error 404</p>
      <h1 class="text-display">No encontramos esta página</h1>
      <p class="mt-5 text-lg text-muted">
        Es posible que la dirección haya cambiado o que el enlace esté incompleto. Puede
        volver al inicio o, si necesita atención inmediata, llamarnos ahora mismo.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="/" variant="primary" icon="arrow-right" iconPosition="end">
          Volver al inicio
        </Button>
        <Button href={contact.emergency.href} variant="urgent" icon="phone">
          Urgencias 24 h
        </Button>
      </div>
    </div>
  </Section>

  <script is:inline>
    /**
     * Rescate de direcciones antiguas.
     *
     * Hasta hace poco el sitio vivía bajo /CentroMedicoCampeche/. Cualquier
     * enlace de esa época —compartido en redes, guardado en favoritos o
     * impreso— cae aquí. En vez de dejar al visitante en un error, se le lleva
     * a la página equivalente en la nueva estructura.
     *
     * La comparación ignora mayúsculas a propósito: el enlace de Facebook
     * estaba escrito en minúsculas y era justo el que fallaba.
     *
     * Va `is:inline` para que se ejecute de inmediato, sin esperar a que Astro
     * descargue un módulo: aquí cada milisegundo es una pantalla de error que
     * el visitante no debería llegar a leer.
     */
    (function () {
      var ruta = window.location.pathname;
      var viejo = /^\/centromedicocampeche(\/|$)/i;

      if (!viejo.test(ruta)) return;

      var destino = ruta.replace(viejo, '/') + window.location.search + window.location.hash;
      window.location.replace(destino);
    })();
  </script>
</BaseLayout>
