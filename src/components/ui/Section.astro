---
import type { HTMLAttributes } from 'astro/types';

type Tone = 'white' | 'surface' | 'deep';

interface Props extends HTMLAttributes<'section'> {
  tone?: Tone;
  /** Necesario cuando la sección tiene encabezado propio (aria-labelledby). */
  labelledby?: string;
  /** Reduce el aire vertical, para franjas compactas como la de confianza. */
  compact?: boolean;
  class?: string;
}

const { tone = 'white', labelledby, compact = false, class: className, ...rest } = Astro.props;

const tones: Record<Tone, string> = {
  white: 'bg-white',
  surface: 'bg-surface',
  // `on-dark` cambia el color del anillo de foco a aqua (ver global.css)
  deep: 'bg-deep text-white on-dark',
};

const rhythm = compact
  ? 'py-12 md:py-16'
  : 'py-[var(--spacing-section)] md:py-[var(--spacing-section-lg)]';
---

<section
  class:list={[tones[tone], rhythm, className]}
  aria-labelledby={labelledby}
  {...rest}
  data-tone={tone}
>
  <div class="container-page">
    <slot />
  </div>
</section>
