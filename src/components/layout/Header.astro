---
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { mainNav } from '@/data/nav';
import { withBase, isCurrentPath } from '@/lib/url';

const pathname = Astro.url.pathname;

/**
 * Header pegajoso. Fondo blanco sólido (no translúcido): detrás pasan
 * fotografías y el texto de la navegación debe conservar su contraste.
 */
---

<header
  class="sticky top-0 z-50 border-b border-hairline bg-white shadow-header"
  data-site-header
>
  <div class="container-page">
    <div class="flex min-h-[var(--header-height)] items-center justify-between gap-4 py-3">
      {/* `min-w-0`: sin esto el enlace se encoge por debajo de su contenido
          —es un item flex y encoge por omision— y el logotipo se desbordaba
          por encima del boton de al lado. */}
      <a
        href={withBase('/')}
        class="flex min-w-0 items-center rounded-sm"
        aria-current={isCurrentPath(withBase('/'), pathname) ? 'page' : undefined}
      >
        <Logo eager />
      </a>

      <nav class="hidden lg:block" aria-label="Navegación principal">
        <ul class="flex items-center gap-1">
          {
            mainNav.map((item) => {
              const href = withBase(item.href);
              const current = isCurrentPath(href, pathname);
              return (
                <li>
                  <a
                    href={href}
                    aria-current={current ? 'page' : undefined}
                    class:list={[
                      'relative flex items-center rounded-sm px-3 text-base tap-target transition-colors',
                      current
                        ? 'font-semibold text-primary'
                        : 'font-medium text-deep hover:text-primary',
                      /* Subrayado del enlace activo, dibujado sin desplazar el texto */
                      current &&
                        'after:absolute after:inset-x-3 after:bottom-2 after:h-0.5 after:rounded-full after:bg-primary',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      {/* Sin boton "Agendar cita" aqui, por dos razones. La primera, que el
          cliente lo pidio fuera. La segunda, que no habia forma limpia de
          ocultarlo: `hidden` desde fuera no puede vencer al `inline-flex` de
          la clase base de Button, porque en Tailwind manda el orden del CSS
          generado y `.inline-flex` sale despues de `.hidden`.
          El acceso a contacto sigue en la navegacion, en el menu movil y en
          el boton ambar bajo el carrusel. */}
      <MobileMenu />
    </div>
  </div>
</header>
